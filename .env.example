# Apenas desenvolvimento local. Nunca usar credenciais/dados reais.
APP_MODE=DEMO
NODE_ENV=development
ENABLE_REAL_MONEY=false
DATABASE_URL=postgresql://financeiro:local_demo_only@127.0.0.1:5432/financeiro_demo
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
API_URL=http://127.0.0.1:4000
# Para dispositivo físico, substituir pelo IP local do computador.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
